# ---- PayPal SANDBOX credentials (optional) -------------------------------
# Create a REST app at https://developer.paypal.com/dashboard/applications/sandbox
# Leave empty to run against the built-in PayPal sandbox SIMULATOR.
# The code refuses to talk to anything except api-m.sandbox.paypal.com.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: sandbox business email that should receive escrow funds (payee)
PAYPAL_PAYEE_EMAIL=

# ---- AI (optional) -------------------------------------------------------
# With a key, Claude reviews every payment request & deliverable in addition to
# the deterministic heuristic reviewer. Without it, the heuristic reviewer runs alone.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: SaaS billing plans (create Billing Plans in the sandbox dashboard) and webhook verification
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_SCALE=
PAYPAL_WEBHOOK_ID=

# ---- App -----------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
PUBLIC_URL=http://localhost:8787
# Operator login token for the dashboard. If empty, a random one is generated, stored in data/.admin-token and printed at startup.
ADMIN_TOKEN=
# HMAC secret for mandates. If empty, a random one is generated once and stored in data/.mandate-secret (0600).
MANDATE_SECRET=
# Set to 0 on any shared/public host: disables demo scenarios and reset.
DEMO_MODE=1
# Set to 1 only behind a trusted reverse proxy so rate limits see the real client IP (X-Forwarded-For).
TRUST_PROXY=0
# Email used by the built-in demo scenarios as the allow-listed vendor payee.
# For the live sandbox, set this to a sandbox personal/business account email.
DEMO_PAYEE_EMAIL=ops@dataset-hub.example
DATA_FILE=data/state.json
